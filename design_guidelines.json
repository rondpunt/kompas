{
  "app_metadata": {
    "name": "Kompas",
    "tagline": "Voor wat speelt.",
    "wordmark_concept": "•Kompas",
    "wordmark_specs": "Small dot same color as text, 5px wide. Text: 15px weight 600 letter-spacing -0.3px",
    "icon_concept": "White circle on black square with thin line as compass needle",
    "audience": "Belgian Dutch (België) adults 25-50",
    "philosophy": "Adult, calm, premium, late-night. Anti-self-optimization, anti-toxic-positivity, 'verwijlen' (linger)."
  },
  "global_rules": {
    "text_case": "Sentence case overall. No TITLE CASE or ALL CAPS (except PLUS badge and eyebrow text).",
    "icons": "Lucide outline-style only. No emojis anywhere in UI text. NO exclamation-mark spam.",
    "animations": "Minimal. 200ms fade for page transitions. Modals slide-up. Streaming AI: typewriter cursor 4px×16px, 1Hz blink. Respect prefers-reduced-motion.",
    "navigation": "No bottom navigation tabs. Everything via sidebar or contextual via chat. ChatGPT-clean UI.",
    "anti_patterns": "NO mood-tracker with badges, NO exercise library, NO DBT toolbox visible.",
    "testing": "All interactive and key informational elements MUST include a data-testid attribute."
  },
